FROM barichello/godot-ci:4.6.1

# Pre-install Blender so it's baked into the image
RUN apt-get update && \
    apt-get install -y --no-install-recommends blender && \
    rm -rf /var/lib/apt/lists/*

# Pre-configure Godot editor settings for Blender path
RUN mkdir -p /github/home/.config/godot && \
    printf '[gd_resource type="EditorSettings" format=3]\n\n[resource]\nfilesystem/import/blender/blender_path = "/usr/bin/blender"\n' \
    > /github/home/.config/godot/editor_settings-4.tres
